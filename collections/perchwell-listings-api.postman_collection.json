      "item": [
        {
          "id": "750dc6ad-eba2-4710-99a2-ee34c549f05e",
          "name": "List listings for an account feed",
          "request": {
            "name": "List listings for an account feed",
            "description": {
              "content": "Returns listings for the given account feed, filtered by listing type, status, and modification window, with page-based pagination. The response includes a total count and an array of Listing objects.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "feeds",
                ":account_name"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "listing_type",
                  "value": "sales,rentals",
                  "description": "Restricts returned listings to sale and/or rental listings."
                },
                {
                  "disabled": false,
                  "key": "listing_status",
                  "value": "active,in_contract,expired,closed,perm_off_market,temp_off_market",
                  "description": "Filters listings by conventional listing statuses (comma-separated): active, in_contract, temp_off_market, perm_off_market, closed, expired, future, lead."
                },
                {
                  "disabled": false,
                  "key": "updated_since",
                  "value": "<string>",
                  "description": "Excludes listings whose updated_at is less than this ISO 8601 value."
                },
                {
                  "disabled": false,
                  "key": "updated_before",
                  "value": "<string>",
                  "description": "Excludes listings whose updated_at is greater than this ISO 8601 value."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "200",
                  "description": "Maximum number of listing records returned per response (0-200)."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page offset for pagination (positive integers)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_name",
                  "description": "(Required) The account name identifying the feed."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
