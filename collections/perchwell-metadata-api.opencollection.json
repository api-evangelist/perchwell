{
  "opencollection": "1.0.0",
  "info": {
    "name": "Perchwell JSON Listings Metadata API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get OData service metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.perchwell.com/$metadata"
          },
          "docs": "Returns the CSDL metadata document describing resources, fields, and lookup values."
        }
      ]
    }
  ],
  "bundled": true
}